+def grid_round_total(grid_label):
+    """Counts stage_*.txt files for the given grid label ("full" or "light")
+    rather than hardcoding 11/7, so this stays correct if the URL lists are
+    ever regenerated with different counts."""
+    d = CAMPAIGN_ROOT / "_url_slices" / grid_label
+    if not d.exists():
+        return None
+    return len(list(d.glob("stage_*.txt")))
+
+
+def deadline_projections(state, mode_counts_now, round_dir):
+    """Returns a list of human-readable warning strings, one per mode
+    projected to miss LICENSE_DEADLINE at its observed recent rate. Also
+    mutates state["rate_history"] in place (caller is responsible for
+    save_state()). Pure best-effort: any missing input (no round dir yet,
+    grid files not found, deadline unparseable) just skips that mode/check
+    rather than raising.
+    """
+    warnings = []
+    now = now_utc()
+    try:
+        deadline = datetime.strptime(LICENSE_DEADLINE, "%Y-%m-%d").replace(tzinfo=timezone.utc)
+    except ValueError:
+        return warnings  # misconfigured constant — don't crash the heartbeat over it
+    days_left = (deadline - now).total_seconds() / 86400.0
+
+    history = state.get("rate_history", [])
+    history.append({"ts": now.isoformat(), "mode_counts": dict(mode_counts_now)})
+    cutoff = now.timestamp() - RATE_WINDOW_HOURS * 3600
+    history = [h for h in history
+               if datetime.fromisoformat(h["ts"]).timestamp() >= cutoff]
+    state["rate_history"] = history
+
+    if round_dir is None or days_left <= 0:
+        return warnings
+    try:
+        current_round = int(round_dir.name.removeprefix("round_"))
+    except ValueError:
+        return warnings
+
+    oldest = history[0]
+    oldest_ts = datetime.fromisoformat(oldest["ts"])
+    window_hours = (now - oldest_ts).total_seconds() / 3600.0
+    if window_hours < MIN_RATE_WINDOW_HOURS:
+        return warnings  # not enough history yet for a stable estimate
+
+    for mode in ("vpn", "tor", "nym5", "nym2"):
+        grid_label = "full" if mode in FULL_GRID_MODES else "light"
+        total_rounds = grid_round_total(grid_label)
+        if total_rounds is None:
+            continue
+        rounds_remaining = total_rounds - current_round
+        if rounds_remaining <= 0:
+            continue  # already at/past this mode's last round
+
+        now_count = mode_counts_now.get(mode)
+        old_count = oldest["mode_counts"].get(mode)
+        if now_count is None or old_count is None or now_count < old_count:
+            continue  # no data, or round rolled over mid-window — skip rather than guess
+        rate_per_day = (now_count - old_count) / (window_hours / 24.0)
+        target = PER_ROUND_TARGET.get(mode)
+        if not target or rate_per_day <= 0:
+            continue
+        rounds_per_day = rate_per_day / target
+        projectable_rounds = rounds_per_day * days_left
+
+        if projectable_rounds < rounds_remaining:
+            days_needed = rounds_remaining / rounds_per_day if rounds_per_day > 0 else float("inf")
+            # CAVEAT (only nym5 has no backfill): vpn/tor/nym2's success count
+            # keeps climbing from backfill visits even while the round itself
+            # is stalled waiting on nym5 (run_stage.sh's shared round-barrier
+            # — see run_stage.sh's backfill-stop-file mechanism). Their rate
+            # here can look healthy/fast while real round progress is zero.
+            # nym5 has no backfill loop, so ITS rate is the trustworthy signal
+            # for when the round actually closes.
+            caveat = ("" if mode == "nym5" else
+                      " [rate may include backfill visits and can look faster "
+                      "than real round progress — cross-check against nym5's "
+                      "own projection, which drives when rounds actually close]")
+            warnings.append(
+                f"{mode}: projected to MISS {LICENSE_DEADLINE} — needs {rounds_remaining} "
+                f"more round(s), observed rate ~{rate_per_day:.0f} successes/day "
+                f"(~{rounds_per_day:.2f} rounds/day) would take ~{days_needed:.1f} day(s), "
+                f"only {days_left:.1f} day(s) remain{caveat}"
+            )
+    return warnings
+
